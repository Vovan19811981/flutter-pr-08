#!/usr/bin/env sh
set -e

GRADLE_VERSION="8.10.2"
GRADLE_HOME_DIR="${HOME}/.gradle/manual/gradle-${GRADLE_VERSION}"
GRADLE_BIN="${GRADLE_HOME_DIR}/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
  TMP_DIR="${TMPDIR:-/tmp}/gradle-${GRADLE_VERSION}-download"
  ZIP_FILE="${TMP_DIR}/gradle.zip"
  mkdir -p "$TMP_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -L "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "$ZIP_FILE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP_FILE" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  else
    echo "curl або wget потрібен для першого запуску Gradle." >&2
    exit 1
  fi
  mkdir -p "$(dirname "$GRADLE_HOME_DIR")"
  unzip -q -o "$ZIP_FILE" -d "$(dirname "$GRADLE_HOME_DIR")"
fi

exec "$GRADLE_BIN" "$@"
